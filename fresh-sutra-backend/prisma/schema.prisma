generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  name          String
  mobileNumber  String   @unique
  email         String?  @unique
  password      String
  role          Role     @default(USER)
  createdAt     DateTime @default(now())

  // New fields for Google Ads Report
  firstName     String?
  lastName      String?
  phone         String?
  country       String?   @default("IN")
  zip           String?
  city          String?

  orders        Order[]
  resetOtp      String?
  otpExpiry     DateTime?
  otpAttempts   Int       @default(0)
  otpRequests   Int       @default(0)
  lastOtpRequest DateTime?
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  storeId   String?
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  VENDOR
}
